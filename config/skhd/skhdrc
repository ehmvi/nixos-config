# skhdrc : raccourcis alignes sur config/hypr/hyprland.lua.
# mainMod = lalt (option gauche), sur lequel caps lock est remappe via hidutil.
# cmd garde les raccourcis macos et ralt (option droite) reste libre pour les accents qwerty-fr.

# modes : default et resize (@ capture les touches non liees tant qu'on y est)
:: default : sketchybar --trigger skhd_mode MODE=default
:: resize @ : sketchybar --trigger skhd_mode MODE=resize

# applications
lalt - q : open -na kitty
lalt - c : yabai -m window --close
lalt - e : open ~
lalt - space : open -a Raycast

# disposition des fenetres
lalt - v : yabai -m window --toggle float --grid 4:4:1:1:2:2
lalt - f : yabai -m window --toggle native-fullscreen
lalt + shift - f : yabai -m window --toggle zoom-fullscreen
lalt - j : yabai -m window --toggle split

# focus directionnel
lalt - left  : yabai -m window --focus west
lalt - right : yabai -m window --focus east
lalt - up    : yabai -m window --focus north
lalt - down  : yabai -m window --focus south

# deplacement directionnel de la fenetre active
lalt + shift - left  : yabai -m window --warp west
lalt + shift - right : yabai -m window --warp east
lalt + shift - up    : yabai -m window --warp north
lalt + shift - down  : yabai -m window --warp south

# mode redimensionnement par pas de 40 px (echap ou entree pour sortir)
lalt - r ; resize
resize < escape ; default
resize < return ; default
resize < right : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0
resize < left  : yabai -m window --resize right:-40:0 || yabai -m window --resize left:-40:0
resize < down  : yabai -m window --resize bottom:0:40 || yabai -m window --resize top:0:40
resize < up    : yabai -m window --resize bottom:0:-40 || yabai -m window --resize top:0:-40

# espace precedent
lalt - tab : yabai -m space --focus recent

# bascule d'espace (1..10) par keycodes virtuels (rangee 1..0 independante du layout)
lalt - 0x12 : yabai -m space --focus 1
lalt - 0x13 : yabai -m space --focus 2
lalt - 0x14 : yabai -m space --focus 3
lalt - 0x15 : yabai -m space --focus 4
lalt - 0x17 : yabai -m space --focus 5
lalt - 0x16 : yabai -m space --focus 6
lalt - 0x1A : yabai -m space --focus 7
lalt - 0x1C : yabai -m space --focus 8
lalt - 0x19 : yabai -m space --focus 9
lalt - 0x1D : yabai -m space --focus 10

# envoi de la fenetre active vers un espace (1..10)
lalt + shift - 0x12 : yabai -m window --space 1
lalt + shift - 0x13 : yabai -m window --space 2
lalt + shift - 0x14 : yabai -m window --space 3
lalt + shift - 0x15 : yabai -m window --space 4
lalt + shift - 0x17 : yabai -m window --space 5
lalt + shift - 0x16 : yabai -m window --space 6
lalt + shift - 0x1A : yabai -m window --space 7
lalt + shift - 0x1C : yabai -m window --space 8
lalt + shift - 0x19 : yabai -m window --space 9
lalt + shift - 0x1D : yabai -m window --space 10

# scratchpad : lance kitty dropterm au premier appui, puis le montre ou le cache
lalt - s : yabai -m window --toggle term || open -na kitty --args --title dropterm
lalt + shift - s : yabai -m window --scratchpad term

# verrouillage et capture de zone
lalt - l : pmset displaysleepnow
lalt + shift - p : mkdir -p "$HOME/Pictures/screenshots" && screencapture -i "$HOME/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"
