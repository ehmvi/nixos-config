#!/bin/sh
# sketchybar : barre du haut de sommei, facon planche gravee (botanique ou
# astronomique du xviiie siecle). vellum clair, filets de 1 px, encre sepia,
# coins vifs. toutes les couleurs viennent de theme.nix (0xAARRGGBB).
# PLUGIN_DIR est rempli par nix (hosts/sommei/default.nix) : les scripts vivent dans le store.
PLUGIN_DIR="@plugins@"

# typographie : texte et chiffres romains en iowan old style, pourcentages en
# times new roman (son "%" n'a pas la boucle qui colle au chiffre precedent),
# icones en nerd font.
SERIF="Iowan Old Style"
NUMFONT="Times New Roman"
GLYPH="JetBrainsMono Nerd Font"

sketchybar --add event yabai_windows
sketchybar --add event skhd_mode

# 14 pouces m1 pro : hauteur 36 et notch_width 200 pour epouser l'encoche sans
# gaspiller d'espace vertical ; yabai reserve la meme hauteur via external_bar.
# fond vellum presque opaque, un seul filet fin en guise de trait de marge.
sketchybar --bar position=top height=36 notch_width=200 topmost=off \
  blur_radius=12 color=0xf5@base.hex@ \
  border_color=0xff@overlay0.hex@ border_width=1 \
  padding_left=10 padding_right=10

# style planche : rien de plein ni d'inverse, encre accent pour les icones,
# encre sombre pour le texte. les cadres sont portes par les brackets.
sketchybar --default \
  icon.font="$GLYPH:Regular:13.0" \
  label.font="$SERIF:Roman:13.0" \
  icon.color=0xff@accent.hex@ \
  label.color=0xff@text.hex@ \
  icon.padding_left=5 icon.padding_right=3 \
  label.padding_left=3 label.padding_right=5 \
  background.drawing=off \
  background.height=22 \
  background.corner_radius=0 \
  padding_left=1 padding_right=1

# filet vertical de 1 px entre deux groupes, comme les colonnes d'une legende.
# largeur dynamique (icon.width=1, pas width=1) : sinon sketchybar ignore
# padding_left/padding_right dans le calcul de largeur et colle le filet a gauche.
divider() {
  sketchybar --add item "$1" "$2" \
    --set "$1" \
      icon=" " icon.width=1 icon.padding_left=0 icon.padding_right=0 \
      label.drawing=off \
      background.drawing=on background.color=0xff@overlay0.hex@ \
      background.height=12 padding_left=4 padding_right=4
}

# gauche : embleme, planches 1..10 (min 3 visibles), puis indicateur de mode skhd
sketchybar --add item apple left \
  --set apple icon=󰀵 icon.font="$GLYPH:Regular:15.0" \
    icon.padding_left=2 icon.padding_right=2 \
    label.drawing=off padding_right=8 click_script="open -a 'System Settings'"

# numeros d'espaces en chiffres romains, comme les numeros de planche
i=1
for numeral in I II III IV V VI VII VIII IX X; do
  sketchybar --add item "space.$i" left \
    --set "space.$i" \
      icon="$numeral" \
      icon.font="$SERIF:Bold:12.0" \
      icon.color=0xff@overlay1.hex@ \
      icon.padding_left=7 icon.padding_right=7 \
      label.drawing=off \
      background.color=0xff@surface1.hex@ \
      background.border_color=0xff@accent.hex@ \
      background.border_width=1 \
      background.height=18 \
      padding_left=0 padding_right=0 \
      click_script="yabai -m space --focus $i"
  i=$((i + 1))
done

sketchybar --set space.1 \
  script="BAR_ACTIVE=0xff@accent.hex@ BAR_TEXT=0xff@text.hex@ BAR_DIM=0xff@overlay1.hex@ $PLUGIN_DIR/workspaces.sh" \
  --subscribe space.1 space_change space_windows_change yabai_windows

# cadre grave autour des espaces : plaque mantle, filet de 1 px
sketchybar --add bracket workspaces '/space\..*/' \
  --set workspaces \
    background.drawing=on \
    background.color=0xff@mantle.hex@ \
    background.border_color=0xff@overlay0.hex@ \
    background.border_width=1 \
    background.height=24 \
    background.corner_radius=0

# mode : cartouche ocre en filet, texte en italique
sketchybar --add item mode left \
  --set mode drawing=off icon=󰩨 label="" \
    icon.color=0xff@yellow.hex@ \
    label.font="$SERIF:Italic:12.0" \
    label.color=0xff@yellow.hex@ \
    background.drawing=on \
    background.color=0xff@base.hex@ \
    background.border_color=0xff@yellow.hex@ \
    background.border_width=1 \
    padding_left=8 \
    script="$PLUGIN_DIR/mode.sh" \
  --subscribe mode skhd_mode

# droite (ajoutee de droite a gauche) : heure tout a droite dans sa propre
# plaque, puis une legende unique batterie | bluetooth wifi | volume | ram cpu
sketchybar --add item clock right \
  --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" \
    background.drawing=on \
    background.color=0xff@surface0.hex@ \
    background.border_color=0xff@overlay0.hex@ \
    background.border_width=1 \
    background.height=24 \
    icon.padding_left=8 label.padding_right=9 \
    padding_left=8 padding_right=0 \
    click_script="open -a Calendar"

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
    label.font="$NUMFONT:Regular:13.0" \
    click_script="open x-apple.systempreferences:com.apple.Battery-Settings.extension" \
  --subscribe battery system_woke power_source_change

divider sep.power right

sketchybar --add item bluetooth right \
  --set bluetooth update_freq=30 label.drawing=off script="$PLUGIN_DIR/bluetooth.sh" \
    icon.padding_right=5 \
    click_script="open x-apple.systempreferences:com.apple.BluetoothSettings"

sketchybar --add item network right \
  --set network update_freq=15 script="$PLUGIN_DIR/network.sh" \
    click_script="open x-apple.systempreferences:com.apple.wifi-settings-extension" \
  --subscribe network wifi_change

divider sep.net right

# volume : seule icone ocre de la legende
sketchybar --add item volume right \
  --set volume \
    icon.color=0xff@yellow.hex@ \
    label.font="$NUMFONT:Regular:13.0" \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change mouse.clicked mouse.scrolled

divider sep.sound right

sketchybar --add item ram right \
  --set ram update_freq=5 script="$PLUGIN_DIR/ram.sh" \
    label.font="$NUMFONT:Regular:13.0" \
    label.color=0xff@subtext1.hex@ \
    click_script="open -a 'Activity Monitor'"

sketchybar --add item cpu right \
  --set cpu update_freq=5 script="$PLUGIN_DIR/cpu.sh" \
    label.font="$NUMFONT:Regular:13.0" \
    label.color=0xff@subtext1.hex@ \
    click_script="open -a 'Activity Monitor'"

# cadre grave unique autour de la legende de droite
sketchybar --add bracket status cpu ram sep.sound volume sep.net network bluetooth sep.power battery \
  --set status \
    background.drawing=on \
    background.color=0xff@mantle.hex@ \
    background.border_color=0xff@overlay0.hex@ \
    background.border_width=1 \
    background.height=24 \
    background.corner_radius=0

sketchybar --update
