{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "theme.nix",
  "author": "fyrr",
  "themes": [
    {
      "name": "theme.nix",
      "appearance": "dark",
      "style": {
        "background": "@base@",
        "background.appearance": "opaque",
        "surface.background": "@base@",
        "elevated_surface.background": "@mantle@",
        "panel.background": "@base@",
        "panel.focused_border": "@accent@",
        "pane.focused_border": "@surface0@",
        "pane_group.border": "@surface0@",
        "status_bar.background": "@base@",
        "title_bar.background": "@base@",
        "title_bar.inactive_background": "@base@",
        "toolbar.background": "@base@",
        "tab_bar.background": "@base@",
        "tab.inactive_background": "@base@",
        "tab.active_background": "@surface0@",

        "border": "@surface0@",
        "border.variant": "@surface0@",
        "border.focused": "@accent@",
        "border.selected": "@accent@",
        "border.transparent": "#00000000",
        "border.disabled": "@surface0@",

        "element.background": "@surface0@",
        "element.hover": "@accent@12",
        "element.active": "@accent@24",
        "element.selected": "@accent@24",
        "element.disabled": "@surface0@",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "@accent@12",
        "ghost_element.active": "@accent@24",
        "ghost_element.selected": "@accent@24",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "@accent@24",

        "text": "@subtext1@",
        "text.muted": "@subtext0@",
        "text.placeholder": "@overlay1@",
        "text.disabled": "@overlay1@",
        "text.accent": "@accent@",
        "icon": "@subtext0@",
        "icon.muted": "@overlay1@",
        "icon.disabled": "@overlay0@",
        "icon.placeholder": "@overlay1@",
        "icon.accent": "@accent@",
        "link_text.hover": "@teal@",

        "search.match_background": "@yellow@40",
        "scrollbar.thumb.background": "@surface2@",
        "scrollbar.thumb.hover_background": "@overlay0@",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "@subtext1@",
        "editor.background": "@base@",
        "editor.gutter.background": "@base@",
        "editor.subheader.background": "@mantle@",
        "editor.active_line.background": "@surface0@80",
        "editor.highlighted_line.background": "@surface0@",
        "editor.line_number": "@overlay0@",
        "editor.active_line_number": "@subtext0@",
        "editor.invisible": "@overlay0@",
        "editor.wrap_guide": "@surface0@",
        "editor.active_wrap_guide": "@surface1@",
        "editor.indent_guide": "@surface0@",
        "editor.indent_guide_active": "@surface2@",
        "editor.document_highlight.read_background": "@accent@1a",
        "editor.document_highlight.write_background": "@accent@2e",

        "terminal.background": "@base@",
        "terminal.foreground": "@text@",
        "terminal.bright_foreground": "@text@",
        "terminal.dim_foreground": "@subtext0@",
        "terminal.ansi.black": "@ansi0@",
        "terminal.ansi.red": "@ansi1@",
        "terminal.ansi.green": "@ansi2@",
        "terminal.ansi.yellow": "@ansi3@",
        "terminal.ansi.blue": "@ansi4@",
        "terminal.ansi.magenta": "@ansi5@",
        "terminal.ansi.cyan": "@ansi6@",
        "terminal.ansi.white": "@ansi7@",
        "terminal.ansi.bright_black": "@ansi8@",
        "terminal.ansi.bright_red": "@ansi9@",
        "terminal.ansi.bright_green": "@ansi10@",
        "terminal.ansi.bright_yellow": "@ansi11@",
        "terminal.ansi.bright_blue": "@ansi12@",
        "terminal.ansi.bright_magenta": "@ansi13@",
        "terminal.ansi.bright_cyan": "@ansi14@",
        "terminal.ansi.bright_white": "@ansi15@",

        "error": "@red@",
        "error.background": "@red@1a",
        "error.border": "@red@",
        "warning": "@yellow@",
        "warning.background": "@yellow@1a",
        "warning.border": "@yellow@",
        "success": "@green@",
        "success.background": "@green@1a",
        "success.border": "@green@",
        "info": "@blue@",
        "info.background": "@blue@1a",
        "info.border": "@blue@",
        "hint": "@subtext0@",
        "hint.background": "@surface0@",
        "hint.border": "@surface1@",
        "created": "@green@",
        "created.background": "@green@1a",
        "modified": "@yellow@",
        "modified.background": "@yellow@1a",
        "deleted": "@red@",
        "deleted.background": "@red@1a",
        "conflict": "@peach@",
        "renamed": "@blue@",
        "hidden": "@overlay1@",
        "ignored": "@overlay1@",
        "predictive": "@overlay1@",
        "unreachable": "@overlay1@",

        "players": [
          { "cursor": "@accent@", "background": "@accent@", "selection": "@accent@33" },
          { "cursor": "@blue@", "background": "@blue@", "selection": "@blue@33" },
          { "cursor": "@lavender@", "background": "@lavender@", "selection": "@lavender@33" },
          { "cursor": "@yellow@", "background": "@yellow@", "selection": "@yellow@33" }
        ],

        "syntax": {
          "comment": { "color": "@overlay1@", "font_style": "italic" },
          "comment.doc": { "color": "@overlay1@", "font_style": "italic" },
          "keyword": { "color": "@accent@" },
          "function": { "color": "@blue@" },
          "constructor": { "color": "@blue@" },
          "string": { "color": "@yellow@" },
          "string.escape": { "color": "@teal@" },
          "string.regex": { "color": "@teal@" },
          "string.special": { "color": "@teal@" },
          "number": { "color": "@lavender@" },
          "boolean": { "color": "@lavender@" },
          "constant": { "color": "@lavender@" },
          "type": { "color": "@teal@" },
          "property": { "color": "@teal@" },
          "attribute": { "color": "@teal@" },
          "tag": { "color": "@accent@" },
          "variable": { "color": "@subtext1@" },
          "variable.special": { "color": "@lavender@" },
          "label": { "color": "@blue@" },
          "operator": { "color": "@subtext0@" },
          "punctuation": { "color": "@subtext0@" },
          "punctuation.bracket": { "color": "@subtext0@" },
          "punctuation.delimiter": { "color": "@subtext0@" },
          "punctuation.special": { "color": "@subtext0@" },
          "embedded": { "color": "@subtext1@" },
          "title": { "color": "@teal@", "font_weight": 500 },
          "emphasis": { "color": "@text@", "font_style": "italic" },
          "emphasis.strong": { "color": "@text@", "font_weight": 700 },
          "link_text": { "color": "@teal@" },
          "link_uri": { "color": "@blue@" },
          "text.literal": { "color": "@yellow@" },
          "hint": { "color": "@subtext0@" },
          "predictive": { "color": "@overlay1@", "font_style": "italic" }
        }
      }
    }
  ]
}
